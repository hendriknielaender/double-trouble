---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="head" data-field-hero>
  <div class="wrap inner">
    <div class="copy" data-field-quiet>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .head {
    padding-block: clamp(4rem, 12vw, 8.5rem) clamp(3rem, 7vw, 5rem);
  }

  .copy {
    max-width: 46rem;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 38rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--fg-muted);
  }
</style>
