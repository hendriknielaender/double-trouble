---
import { formatDate, groupByYear, type Post, postUrl } from "~/lib/posts";

interface Props {
  posts: Post[];
  headingLevel?: "h2" | "h3";
}

const { posts, headingLevel: Heading = "h2" } = Astro.props;
const years = groupByYear(posts);
---

<div class="archive">
  {
    years.map(([year, entries]) => (
      <section class="year" aria-label={String(year)}>
        <Heading class="label meta">{year}</Heading>
        <ol>
          {entries.map((post) => (
            <li>
              <a href={postUrl(post)}>
                <span class="title">{post.data.title}</span>
                <span class="description">{post.data.description}</span>
                <time class="meta" datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate, "short")}
                </time>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year {
    display: grid;
    grid-template-columns: 7rem 1fr;
    border-top: 1px solid var(--line);
  }

  .year:last-child {
    border-bottom: 1px solid var(--line);
  }

  .label {
    padding-top: 1.45rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 2rem;
    padding: 1.25rem 1rem;
    margin-inline: -1rem;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .title {
    font-size: 1.125rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .description {
    grid-column: 1;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  time {
    grid-row: 1;
    grid-column: 2;
    padding-top: 0.25rem;
  }

  @media (hover: hover) {
    a:hover {
      background: color-mix(in oklab, var(--fg) 4%, transparent);
    }
  }

  @media (max-width: 40rem) {
    .year {
      grid-template-columns: 1fr;
    }

    .label {
      padding-top: 1.25rem;
    }

    .description {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
