<canvas class="field" data-field aria-hidden="true"></canvas>

<script>
  import { startField } from "~/scripts/field";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
  if (canvas) {
    let epoch = Date.now() - Math.random() * 600_000;
    try {
      epoch = Number(sessionStorage.getItem("field-epoch")) || epoch;
      sessionStorage.setItem("field-epoch", String(epoch));
    } catch {}
    const run = () => startField(canvas, epoch);
    const schedule = () =>
      "requestIdleCallback" in window
        ? requestIdleCallback(run, { timeout: 2000 })
        : setTimeout(run, 300);
    if ("fieldResume" in document.documentElement.dataset) {
      run();
    } else if (document.readyState === "complete") {
      schedule();
    } else {
      addEventListener("load", schedule, { once: true });
    }
  }
</script>

<style>
  .field {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .field[data-ready] {
    opacity: 1;
  }

  :global([data-field-resume]) .field {
    transition: none;
  }
</style>
