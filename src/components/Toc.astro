---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  variant: "aside" | "inline";
  minutes?: number;
}

const { headings, variant, minutes } = Astro.props;
const list = headings.map((heading) => ({
  href: `#${heading.slug}`,
  text: heading.text,
}));
---

{
  variant === "aside" ? (
    <nav class="toc aside" aria-label="Contents" data-toc>
      <p class="meta">Contents</p>
      <ol>
        {list.map(({ href, text }) => (
          <li>
            <a href={href}>{text}</a>
          </li>
        ))}
      </ol>
      {minutes !== undefined && (
        <p class="meta left">
          <span data-toc-left data-minutes={minutes}>
            {minutes} min left
          </span>
        </p>
      )}
    </nav>
  ) : (
    <details class="toc inline">
      <summary class="meta">Contents</summary>
      <nav aria-label="Contents" data-toc>
        <ol>
          {list.map(({ href, text }) => (
            <li>
              <a href={href}>{text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .aside {
    position: sticky;
    top: calc(var(--header) + 2rem);
    max-height: calc(100dvh - var(--header) - 4rem);
    overflow-y: auto;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aside .meta {
    margin-bottom: 1rem;
  }

  a {
    display: block;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-faint);
    font-size: 0.875rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  a:hover {
    color: var(--fg);
  }

  a[aria-current] {
    color: var(--fg);
    font-weight: 560;
    border-bottom-color: var(--fg);
  }

  .left {
    margin-top: 1.25rem;
  }

  .left span {
    display: inline-block;
    transition:
      opacity 160ms ease,
      filter 160ms ease;
  }

  .left span[data-swapping] {
    opacity: 0;
    filter: blur(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .left span {
      transition: none;
    }
  }

  .inline {
    interpolate-size: allow-keywords;
    margin-bottom: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-raised);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    cursor: pointer;
  }

  .inline::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 220ms var(--ease-out),
      opacity 220ms var(--ease-out),
      content-visibility 220ms var(--ease-out) allow-discrete;
  }

  .inline[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .inline::details-content {
      transition:
        opacity 150ms ease,
        content-visibility 150ms ease allow-discrete;
    }
  }

  .inline nav {
    padding: 0 1.25rem 0.75rem;
  }

  .inline li:last-child a {
    border-bottom: 0;
  }
</style>
