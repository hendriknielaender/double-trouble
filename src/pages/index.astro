---
import { SITE } from "astrowind:config";
import { getCanonical, getHomePermalink } from "~/utils/permalinks";
import Layout from "~/layouts/PageLayout.astro";

import HighlightedPosts from "~/components/blog/HighlightedPosts.astro";

const meta = {
  title: SITE.title,
  description: SITE.description,
  canonical: getCanonical(getHomePermalink()),
};
---

<Layout {meta}>
  <div style="text-align:center">
    <h2
      class="mt-8 text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none lg:mb-5 group font-heading"
    >
      Twice the fun, <div
        class="bg-clip-text text-transparent bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-yellow-600 to-yellow-100"
      >
        <i>double</i>
      </div> the trouble.
    </h2>
    <div class="mb-20 mt-8">
    <div id="leftFist" class="absolute left-1/2 w-24 h-24"><span class="flex items-center justify-center w-full h-full text-9xl select-none">🤜</span></div>
    <div id="rightFist" class="absolute left-1/2 w-24 h-24"><span class="flex items-center justify-center w-full h-full text-9xl select-none">🤛</span></div>
    </div>
  </div>
  <HighlightedPosts />
</Layout>

<style>
  #leftFist {
    transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% - 62.5%));
  }
  #rightFist {
    transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% + 62.5%));
  }

  @keyframes fist-bump-left {
    from { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% - 125%)); }
    to   { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% - 62.5%)); }
  }

  @keyframes fist-bump-right {
    from { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% + 125%)); }
    to   { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% + 62.5%)); }
  }

  @keyframes fist-intro-left {
    from { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% - 125%)); }
    to   { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% - 62.5%)); }
  }

  @keyframes fist-intro-right {
    from { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% + 125%)); }
    to   { transform: translateY(calc(-50% + 3rem)) translateX(calc(-50% + 62.5%)); }
  }

  @supports (animation-timeline: scroll()) {
    #leftFist {
      animation: fist-bump-left auto linear forwards;
      animation-timeline: scroll(root);
      animation-range: 0% 50%;
    }
    #rightFist {
      animation: fist-bump-right auto linear forwards;
      animation-timeline: scroll(root);
      animation-range: 0% 50%;
    }
  }

  @media (min-height: 900px) {
    @supports (animation-timeline: scroll()) {
      #leftFist {
        animation: fist-intro-left 0.7s cubic-bezier(0.3, 0, 0.7, 1) 0.4s forwards;
        animation-timeline: auto;
        animation-range: normal;
      }
      #rightFist {
        animation: fist-intro-right 0.7s cubic-bezier(0.3, 0, 0.7, 1) 0.4s forwards;
        animation-timeline: auto;
        animation-range: normal;
      }
    }
  }
</style>
