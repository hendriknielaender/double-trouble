---
import PageHead from "~/components/PageHead.astro";
import Base from "~/layouts/Base.astro";
import { site } from "~/site";
---

<Base title="About" description="Double Trouble is a shared blog by two software engineers, Hendrik and Felix.">
  <PageHead
    eyebrow="About"
    title="Two engineers, one blog."
    lede="Double Trouble is a shared blog by Hendrik Nieländer and Felix Brilej. We use it to share our technical opinions and findings with a wider audience."
  />
  <div class="wrap" data-field-clear>
    <ul class="pair">
      <li class="hendrik">
        <span class="dot" aria-hidden="true"></span>
        <p>Hello from Hendrik.</p>
      </li>
      <li class="felix">
        <span class="dot" aria-hidden="true"></span>
        <p>Hello from Felix.</p>
      </li>
    </ul>
    <div class="prose">
      <h2>What we write about</h2>
      <p>
        Mostly the things we run into at work and on the side: cloud infrastructure on AWS and
        Cloudflare, CI/CD pipelines, developer tooling, new language releases and the conferences we
        visit.
      </p>
      <h2>Say hello</h2>
      <p>
        Follow along via <a href="/rss.xml">RSS</a> or on <a href={site.x}>X</a>, and find the
        source of this site on <a href={site.repo}>GitHub</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0 0 clamp(3rem, 7vw, 5rem);
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .dot {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .hendrik .dot {
    background: var(--left);
  }

  .felix .dot {
    background: var(--right);
  }

  .prose {
    max-width: var(--measure);
  }

  .prose h2:first-child {
    margin-top: 0;
  }
</style>
